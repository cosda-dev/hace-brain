    note: "Phai xong truoc khi cargo build pass"

  TASK-B02 [P1, ~30min, CTO]:
    title: "Fix RuntimeDispatcher multi-bridge routing"
    target: brain/runtime/src/dispatcher.rs
    approach: |
      RuntimeDispatcher { bridges: HashMap<String, Box<dyn RuntimeBridge>> }
      fn dispatch(&self, sio: RuntimeSio) -> Result<RuntimeOutcome, &str>:
        let provider = &sio.runtime.provider;
        self.bridges.get(provider)
            .or_else(|| self.bridges.get("hacedle"))
            .ok_or("no bridge")
            ?.invoke(sio)

  TASK-B03 [P1, ~30min, CTO]:
    title: "Fix execute/mod.rs â€” xoa fn execute_brain stub"
    approach: |
      Xoa fn execute_brain() {} tu mod.rs
      Tao execute.rs: pub fn execute_brain(session: BrainSession) -> SioOutcome
      Tao checkpoint.rs: pub struct Checkpoint { session_id, state }
      Tao telemetry.rs: pub struct TelemetryData { latency_ms, tokens_used }

  TASK-B04 [P2, ~3h, CTO]:
    title: "Implement BrainBlock::forward() dung cac ops hien co"
    dependency: "crate::vkm::LayerKv phai ton tai truoc"
    approach: |
      B1: Tao brain/src/vkm.rs:
        pub struct LayerKv { pub k: Vec<f32>, pub v: Vec<f32> }
      B2: forward() sequence:
        rmsnorm -> attention_forward -> residual -> rmsnorm -> FFN(gate*up*down) -> residual
      B3: Dung attention_forward() tu attention.rs (sau khi fix GAP-07)

  TASK-B05 [P2, ~2h, CTO]:
    title: "Implement MasterRuntime dispatch chain"
    dependency: "GAP-01, GAP-02 phai done"
    approach: |
      BrainMasterRuntime::execute(sio):
        1. session = BrainSession::from_sio(sio)
        2. provider_type = ProviderSelector::select(&session.runtime_sio)
        3. provider = ProviderFactory::create(cfg_from_type)
        4. outcome = provider.execute(&session.runtime_sio)?
        5. Return outcome

