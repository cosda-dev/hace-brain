  rope:
    brain_src:   "brain/src/op/rope.rs â€” rope(theta, pos, dim, x: &mut [f32]) in-place"
    hacedle_ops: "fem/hacedle/src/ops/rope.rs â€” apply_rope_pairwise() returns new Vec"
