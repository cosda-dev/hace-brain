---

## A1. RR/CLI DNA

```yaml
path: engine/rr/cli/src/lib.rs
no_std: true

structs:
  CliCommand:      {family:CommandFamily, action:&str, raw:&str}
  ParsedCommandHead: {style:CommandStyle, head:&str, tail:&str, left:Option<&str>, right:Option<&str>}

enums:
  CommandStyle: [Artisan, Git, Domain, Unknown]
  CommandFamily: [Intent, Rfn, Cap, Ape, Rc, Evidence, Helio]
  # MISSING: Brain

functions:
  parse_family(name) -> Option<CommandFamily>
  is_known_family(name) -> bool
  is_known_action(family, action) -> bool
  detect_style(head, tail) -> CommandStyle
  parse_command_head(raw) -> ParsedCommandHead

registered_actions:
  intent: [parse, inspect, normalize]
  rfn:    [resolve, inspect, route]
  cap:    [discover, inspect, providers, compatibility, register]
  ape:    [discover, verify, assemble, run, inspect, seal]
  rc:     [bind, verify, inspect, issue]
  evidence: [trace, inspect, commit]
  helio:  [search, pull, verify, publish]

CRITICAL_GAP:
  parse_family("brain") = None
  is_known_family("brain") = FALSE
  consequence: ME gate rejects ALL "hace brain *" before dispatcher
  fix: Add CommandFamily::Brain + BRAIN_ACTIONS to rr/cli lib.rs
```

