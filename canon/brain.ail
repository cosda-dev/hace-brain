## CE Registry

```yaml
ce_registry:
  CE.Algo:
    impl: AlgoParticle
    path: brain/base/src/lib.rs
    use_when: "Simple actions, no model needed"
    output: "deterministic, zero tokens"

  CE.Hacedle:
    impl: HacedleBrain (MISSING â€” fem/hacedle/src/brain/ empty)
    path: fem/hacedle/src/brain/mod.rs
    use_when: "Edge inference, local GGUF, no_std capable"
    engine: "Candle (fem/hacedle/src/x/provider/candle/)"
    status: GAP â€” implement HacedleBrain trait

  CE.Llama:
    impl: LlamaBrain (stub)
    path: fem/llama/src/
    use_when: "llama.cpp backend, higher quality"
    status: FUTURE

  CE.Remote:
    impl: RemoteBrain (stub)
    path: brain/runtime/src/bridges/
    use_when: "Cloud RACEX, expert brain pool"
    status: E4.5
```

---

## Error Boundaries

```yaml
error_map:
  GgufLoad:
    triggers: [file_not_found, bad_magic, unsupported_version, oom]
    handler: "BrainError::ModelUnavailable â€” propagate to CLI, print path"
    no_panic: true

  Tokenize:
    triggers: [vocab_not_loaded, unknown_token, utf8_error]
    handler: "BrainError::ReasonFailed â€” fallback to ASCII if cli --raw-tokens"
    no_panic: true

  KvCache:
    triggers: [alloc_fail, seq_too_long]
    handler: "BrainError::ContextTooLarge { tokens } â€” return before forward"
    no_panic: true

  Inference:
    triggers: [tensor_shape_mismatch, nan_logits, timeout]
    handler: "BrainError::ReasonFailed â€” log + return Err"
    no_panic: true
```

