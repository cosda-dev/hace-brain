## HacedleKernel bridge â€” required wire (kernel/hacedle.rs)

```yaml
file:   "brain/master/src/kernel/hacedle.rs"
current_status: "SKELETON 1.74KB â€” method bodies are stubs"

required_wire: |
  use hace_fem_hacedle::x::provider::candle::inference::CandleInferenceEngine;
  use hace_fem_hacedle::x::loader::gguf::loader_std::GgufLoaderStd;

  pub struct HacedleKernel {
      engine: CandleInferenceEngine,
      model:  LoadedModel,
  }

  impl HacedleKernel {
      pub fn from_gguf(path: &str) -> Result<Self, BrainError> {
          let model  = GgufLoaderStd::open(path)...?;
          let engine = CandleInferenceEngine::init(&model)?;
          Ok(Self { engine, model })
      }

      pub fn forward(
          &self, token_ids: &[u32], kv: &mut KvCache
      ) -> Result<Vec<f32>, BrainError> {
          self.engine.forward(&self.model, token_ids, kv)
              .map_err(|e| BrainError::ReasonFailed { msg: e.to_string() })
      }
  }

cargo_dep: |
  # brain/master/Cargo.toml
  hace-fem-hacedle = { path = "../../../../fem/hacedle",
                       default-features = false,
                       features = ["alloc", "candle-provider"] }
```

---

## IPO contract

```yaml
input:
  I1: "token_ids: &[u32]        â€” from BrainTokenizer::encode()"
  I2: "model: &LoadedModel      â€” from GgufLoader::load()"
  I3: "kv: &mut KvCache         â€” pre-allocated, passed in"
  I4: "n_tokens_to_generate: u32 â€” default 1 for first token"

process:
  for pos in 0..token_ids.len():
    emb    = embed(token_ids[pos], model.tensor_index)
    hidden = for l in 0..model.model_spec.n_layers:
               layer_forward(pos, hidden, &mut kv.layer(l), weights[l])
  logits = lmhead_forward(hidden, model.tensor_index)
  return logits

output:
  O1: "logits: Vec<f32>[vocab_size]"

errors:
  BrainError::RuntimeNotLoaded:  "HacedleKernel.forward() called before load()"
  BrainError::ReasonFailed:      "any tensor shape mismatch, NaN, OOM â€” no panic"
  BrainError::ContextTooLarge:   "token_ids.len() > model.model_spec.context_length"
```

