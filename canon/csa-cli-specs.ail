## S3. WIRING CHANGES REQUIRED

```yaml
# 1. rr/cli/src/lib.rs -- ADD brain family
CommandFamily::Brain

const BRAIN_ACTIONS: &[&str] = &[
  "run","chat",
  "model.list","model.inspect","model.verify",
  "lora.list","lora.inspect","lora.verify","lora.attach","lora.detach","lora.stack",
  "kv.stats","kv.inspect","kv.flush",
  "replay","replay.certify","replay.diff",
  "inspect.tensor","inspect.block","inspect.rope","inspect.lora",
  "bench","bench.q4k","bench.lora",
  "profile.list","profile.create","profile.activate","profile.show",
];

# 2. hace/cli/Cargo.toml -- ADD
hace-brain-cli = { path = "../brain/cli" }

# 3. hace/cli/src/cmd/brain.rs -- REPLACE BrainArgs with subcommand enum
pub enum BrainCommand {
  Model(ModelArgs), Lora(LoraArgs), Kv(KvArgs),
  Run(RunArgs), Chat(ChatArgs), Replay(ReplayArgs),
  Inspect(InspectArgs), Bench(BenchArgs), Profile(ProfileArgs),
}
impl CommandModule for BrainModule {
  fn handle(&self, ir:CliIR, ctx:&Context) -> Result<()> {
    hace_brain_cli::dispatch_ir(ir).map_err(|_| CliError::ExecutionFailed)
  }
}

# 4. hace/cli/src/main.rs -- REPLACE manual bypass
fn main() {
  let cli = Artisan::parse();
  let ctx = Context::from_env();
  let ir = ir_builder::from_cli(&cli, &ctx);
  if let Err(e) = dispatcher::dispatch(ir, ctx) {
    eprintln!("error: {:?}", e); std::process::exit(1);
  }
}
# DELETE: handle_brain(), manual arg loop

# 5. brain/cli/Cargo.toml -- ADD
hace-brain-runtime = { path = "../runtime" }
hace-brain-master  = { path = "../master" }
hace-fem-hacedle   = { path = "../../fem/hacedle" }
hace-fem-zes       = { path = "../../fem/zes" }

# 6. brain/cli/src/lib.rs -- EXPORT
pub fn dispatch_ir(ir: CliIR) -> Result<(), BrainCliError> {
  BrainExecutor::execute(BrainRouter::route_ir(&ir)?)
}

# 7. brain/cli/src/executor.rs -- WIRE REAL CALLS (not stubs)
impl ModelExecutor {
  fn inspect(path:&str) -> Result<()> {
    let hdr = GgufLoader::parse_header(path)?;  // REAL -- not println!
    println!("tensors: {}", hdr.tensor_count);
    Ok(())
  }
}
impl LoraExecutor {
  fn verify(path:&str) -> Result<()> {
    let hdr = LroParser::parse(path)?;
    ZesVerifier::verify(&hdr, &mmap_bytes(path)?)?;  // HARD_REJECT on fail
    println!("ZES: VALID"); Ok(())
  }
}
```

