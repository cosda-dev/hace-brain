  attention: "hacedle::ops::attention (canonical â€” GAP-02 let mut fix needed)"
  ffn_norm:  "hacedle::ops::rmsnorm"
  silu_gate: "hacedle::ops::silu"
  matmul:    "hacedle::ops/matmul.rs (must exist in hacedle/ops â€” verify)"

gap: |
  layer.rs imports hacedle::ops::* â€” verify all ops are exported from lib.rs.
  attention.rs GAP-02 (let mut) must be fixed for layer to produce correct output.
